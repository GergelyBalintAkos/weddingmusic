# ---------------------------------------------------------------
# weddingmusic.ro - static site (replaces the old WordPress site)
# Requires Apache / LiteSpeed with mod_rewrite + mod_alias.
# ---------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml
</IfModule>

# --- Test host only (test.weddingmusic.ro): keep out of search ---
# Deliberately NOT "every host except production": other sites/subdomains
# living under public_html would inherit this file.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^test\.weddingmusic\.ro$ [NC]
  RewriteRule ^ - [E=NOINDEX:1]
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX
</IfModule>

# --- Other domains served from this folder -> the main site (301) ---
# classis.ro / artist-center.ro point at public_html too; the old WordPress
# redirected them to www.weddingmusic.ro, so keep doing that (path preserved,
# so the old-URL rules below still apply on the second hop).
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_HOST} ^(www\.)?(classis|artist-center)\.ro$ [NC]
  RewriteRule ^(.*)$ https://www.weddingmusic.ro/$1 [L,R=301,NE]
</IfModule>

# --- Canonical host: https + www (production domain only) ---
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_HOST} ^weddingmusic\.ro$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?weddingmusic\.ro$ [NC]
  RewriteRule ^ https://www.weddingmusic.ro%{REQUEST_URI} [L,R=301]

  # /index.html, /en/index.html, /hu/index.html -> folder URL
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301,NE]
</IfModule>

# --- Old WordPress URLs -> new pages (301) / removed pages (410) ---
# mod_rewrite (not mod_alias) so these rules are NOT inherited by other sites
# living in sub-folders of public_html (e.g. /musicalevents).
# They apply to www.weddingmusic.ro only: S=11 skips the 11 rules below for
# any other host. If you add or remove a rule, update the number.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_HOST} !^www\.weddingmusic\.ro$ [NC]
  RewriteRule ^ - [S=11]

  # Specific pages first (first match wins thanks to L)
  RewriteRule ^pages/about-us/?$ /despre-noi.html [R=301,L]
  RewriteRule ^pages/contact/?$ /contact.html [R=301,L]
  RewriteRule ^(dotari-sonorizare|inchiriere-videoproiector-si-ecran)/?$ /dotari-tehnice.html [R=301,L]
  RewriteRule ^(repertoriul-general-weddingmusic|repertoriu-crestin-penticostal|repertoriu-imnuri-crestine-adventiste)/?$ /repertoriu.html [R=301,L]
  RewriteRule ^privacy-policy-2/?$ /confidentialitate.html [R=301,L]
  RewriteRule ^videos/?$ /videogalerie.html [R=301,L]

  # Services page + agency / impresariat posts -> services
  RewriteRule ^(services|prima-formatie-de-muzica-live-[a-z0-9-]+|societatea-noastra-de-interpretare-[a-z0-9-]+|proiect-de-concert-in-aer-liber-[a-z0-9-]+|mii-de-oameni-[a-z0-9-]+|compania-noastra-de-impresariat-[a-z0-9-]+)/?$ /servicii.html [R=301,L]

  # Blog index + press / event posts -> portfolio
  RewriteRule ^(blog|concert-de-craciun-viseu-de-sus|formatia-classis-[a-z0-9-]+|cvartetul-classis-[a-z0-9-]+|orchestra-classis-[a-z0-9-]+|soprana-cristina-oltean-[a-z0-9-]+|primul-concert-anatholis-classis|anatholis-classis-[a-z0-9-]+|revelionul-2013-la-cluj-si-turda|articol-de-presa-[a-z0-9-]+|diploma-pentru-organizarea-concertelor-clasice|pianistul-formatiei-classis-[a-z0-9-]+|(martie|aprilie|mai|august)-2015-[a-z0-9-]+)/?$ /portofoliu.html [R=301,L]

  # Theme demo / template leftovers -> gone (410)
  RewriteRule ^(elements|shop|discography|albums|events|event|gallery|release|home|landing|artist|pages|custom-404|sample-page|hello-world|whats-new-in-version-3)(/|$) - [G,L]
  RewriteRule ^(blog|videos)/.+ - [G,L]
  RewriteRule ^(wp-admin|wp-content/plugins|wp-content/themes|wp-includes|wp-json|xmlrpc\.php|feed|comments)(/|$) - [G,L]
</IfModule>
